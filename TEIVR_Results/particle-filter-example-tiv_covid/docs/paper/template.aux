\citation{Andrieu2010,Kantas2009}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textbf  {Quantitative Comparison of Posterior Distributions.} Normalised Wasserstein distance ($W_1$) between the 1D marginal posteriors of the NPE and the SMC baseline for patient 432192, cf. Figures \ref {fig:corner_plot}, \ref {fig:corner_particlefilter}. Low values for the core kinetic parameters ($\beta , \pi , V_0$) indicate strong distributional agreement. The higher distance for $\rho $ reflects the difference in posterior width, where NPE successfully constrained the parameter while the SMC baseline remained uninformative.}}{13}{table.caption.6}\protected@file@percent }
\newlabel{tab:wasserstein_scores}{{2}{13}{\textbf {Quantitative Comparison of Posterior Distributions.} Normalised Wasserstein distance ($W_1$) between the 1D marginal posteriors of the NPE and the SMC baseline for patient 432192, cf. Figures \ref {fig:corner_plot}, \ref {fig:corner_particlefilter}. Low values for the core kinetic parameters ($\beta , \pi , V_0$) indicate strong distributional agreement. The higher distance for $\rho $ reflects the difference in posterior width, where NPE successfully constrained the parameter while the SMC baseline remained uninformative}{table.caption.6}{}}
\newlabel{tab:wasserstein_scores@cref}{{[table][2][]2}{[1][12][]13}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Comparison of computational resources. Times are reported in hours (h). The JSF-NPE method resolves both the throughput and latency bottlenecks: the fixed training cost enables scalable population analysis, while the sub-second inference time enables real-time clinical application.}}{13}{table.caption.7}\protected@file@percent }
\newlabel{tab:runtime}{{3}{13}{Comparison of computational resources. Times are reported in hours (h). The JSF-NPE method resolves both the throughput and latency bottlenecks: the fixed training cost enables scalable population analysis, while the sub-second inference time enables real-time clinical application}{table.caption.7}{}}
\newlabel{tab:runtime@cref}{{[table][3][]3}{[1][13][]13}}
